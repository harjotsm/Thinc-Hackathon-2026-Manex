# Resolve — app-side env (NOT committed). Copy to .env.local at repo root + symlink to web/.env.local.
# These values come from the Manex team handout; spec §16.3.

# Manex remote Postgres + PostgREST
MANEX_API_URL=http://34.89.205.150:8005/
MANEX_ANON_KEY=<paste-team-anon-jwt>
MANEX_SERVICE_ROLE_KEY=<paste-team-service-role-jwt>
MANEX_PG_URL=postgres://team_writer_deconstructors:<pw>@34.89.205.150:5435/hackathon
MANEX_IMAGES_URL=http://34.89.205.150:9000/defect_images/

# Publicly-safe copies for client bundle (Next.js public env)
NEXT_PUBLIC_MANEX_API_URL=http://34.89.205.150:8005/
NEXT_PUBLIC_MANEX_ANON_KEY=<same-as-MANEX_ANON_KEY>

# LLM providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Worker auth (random 32+ chars)
CRON_SECRET=<random-string>

# Optional: app-side demo-user header override (spec §12.5)
NEXT_PUBLIC_DEMO_USER_ID=user_eng_anna
